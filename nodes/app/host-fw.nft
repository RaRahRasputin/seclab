#!/usr/sbin/nft -f
# app - HOST firewall (hardened profile).
# Matters because the network firewall on core cannot see traffic between two
# hosts in the SAME VLAN - that never passes through a router. Each server
# therefore enforces its own rules as well (micro-segmentation).

table inet filter {
  counter in_drop  { }
  counter out_drop { }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    ip saddr 10.10.30.10 tcp dport 8443 accept          # API: from the DMZ web server only
    ip saddr 10.10.99.10 tcp dport 22 accept            # SSH: from the bastion only
    ip saddr 10.10.99.20 tcp dport 9100 accept          # metrics: to Prometheus only
    icmp type echo-request limit rate 5/second accept
    counter name in_drop drop
  }

  chain output {
    type filter hook output priority filter; policy drop;
    oifname "lo" accept
    ct state established,related accept
    ip daddr 10.10.20.20 tcp dport 5432 accept          # the database, nothing else
    counter name out_drop drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }
}
