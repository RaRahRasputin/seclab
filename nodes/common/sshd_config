# Hardened sshd configuration used by every node except the bastion
# (the bastion has its own two files so that it can be switched between profiles).
# Mounted at /lab/common/sshd_config

Port 22
AddressFamily inet

# --- Authentication: keys only, never root, one named account -------------
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
AllowUsers labadmin
UsePAM no

# --- Limit what an attacker gets to try -----------------------------------
MaxAuthTries 3
MaxSessions 4
LoginGraceTime 20

# --- Servers are destinations, not stepping stones ------------------------
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

# --- Drop dead sessions, keep detailed logs -------------------------------
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
PrintMotd no
Subsystem sftp internal-sftp
