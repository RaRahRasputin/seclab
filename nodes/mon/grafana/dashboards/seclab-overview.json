  {
   "id": 14,
   "type": "timeseries",
   "title": "Lab host CPU busy",
   "description": "CPU of the whole lab host. Containers share one kernel, so node_exporter reports the same CPU figures from every node; per-container CPU is measured with 'docker stats' in the benchmark instead.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{node=\"mon\", mode=\"idle\"}[30s])))",
     "legendFormat": "all cores, percent busy",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
