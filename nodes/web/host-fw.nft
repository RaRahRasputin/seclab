#!/usr/sbin/nft -f
# web - HOST firewall (hardened profile).
# Second layer behind the edge firewall. Note the OUTPUT policy: a DMZ server
# that has been broken into cannot "phone home" or scan inwards, because the
# only connection it may start is to the application API.

table inet filter {
  counter in_drop  { }
  counter out_drop { }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    tcp dport { 80, 443 } accept                        # the public service
    ip saddr 10.10.99.10 tcp dport 22 accept            # SSH from the bastion only
    ip saddr 10.10.99.20 tcp dport 9100 accept          # metrics to Prometheus only
    icmp type echo-request limit rate 5/second accept
    counter name in_drop drop
  }

  chain output {
    type filter hook output priority filter; policy drop;
    oifname "lo" accept
    ct state established,related accept
    ip daddr 10.10.20.10 tcp dport 8443 accept          # application API (mutual TLS)
    counter name out_drop drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }
}
